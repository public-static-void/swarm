{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "./plugins/protocol-gate",
    "./plugins/delegation-gate",
    "./plugins/knowledge-gate",
    "@franlol/opencode-md-table-formatter@latest"
  ],
  "subagent_depth": 2,
  "default_agent": "overseer",
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "scout": {
      "disable": true
    },

    "overseer": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "explorer": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "spec-weaver": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "pathfinder": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "analyzer": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "artisan": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "committer": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "inspector": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "scribe": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "habit-builder": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    }
  }
}
