{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "./plugins/protocol-gate",
    "./plugins/delegation-gate",
    "./plugins/knowledge-gate"
  ],
  "experimental": {
    "subagent_depth": 2
  },
  "default_agent": "overseer",
  "agents": {
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "scout": {
      "disabled": true
    },

    "overseer": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "explorer": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "spec-weaver": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "pathfinder": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "analyzer": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "artisan": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "committer": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "inspector": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "scribe": {
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "habit-builder": {
      "model": "opencode/deepseek-v4.1-flash-free"
    }
  }
}
